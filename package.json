{
  "name": "herdr-brigade",
  "version": "1.1.0",
  "description": "A brigade of coding agents (Claude Code, Codex, pi) inside herdr-app.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": "22.23.3"
  },
  "bin": {
    "brigade": "src/entrypoints/cli.ts"
  },
  "scripts": {
    "brigade": "node src/entrypoints/cli.ts",
    "prepare": "lefthook install",
    "check:node": "node scripts/check-node.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p .",
    "deps": "depcruise src scripts --config .dependency-cruiser.cjs",
    "knip": "knip",
    "suppressions": "node scripts/count-suppressions.ts",
    "test": "vitest run --coverage",
    "precommit": "npm run check:node && npm run format:check && npm run lint && npm run typecheck",
    "gate": "npm run check:node && npm run format:check && npm run lint && npm run typecheck && npm run deps && npm run knip && npm run suppressions && npm run audit && npm test",
    "audit": "npm audit --omit=dev",
    "e2e": "scripts/e2e.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "knip": "6.44.2",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
