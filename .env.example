# herdr-brigade reads these environment variables; all are optional.
# Settings live in ~/.config/herdr-brigade/config.json (`brigade init` writes it).
# BRIGADE_CONFIG=~/.config/herdr-brigade/config.json   # the config file
# BRIGADE_STATE=~/.local/state/herdr-brigade           # event log and agent files
# BRIGADE_WORKTREES=~/.herdr/worktrees                  # where task worktrees go
# BRIGADE_HC=hc                                         # the hc binary
# BRIGADE_ROLE, BRIGADE_PROJECT, BRIGADE_TASK, BRIGADE_TITLE and BRIGADE_PARENT are set by brigade for each agent's MCP server.
